            <class name="shashiRoughwork.Demo1" />
        </classes>
    </test>

    <!-- Edge execution -->
    <test name="Edge Test">
        <parameter name="browser" value="edge" />
        <classes>
            <class name="shashiRoughwork.Demo1" />
        </classes>
    </test>

</suite>